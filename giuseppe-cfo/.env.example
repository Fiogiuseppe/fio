# Optional local-app login. Generate on the primary computer:
# python -c "import bcrypt; print(bcrypt.hashpw(b'choose-a-long-password', bcrypt.gensalt()).decode())"
# GIUSEPPE_CFO_PASSWORD_HASH=
# Optional idle timeout in minutes; defaults to 30.
# GIUSEPPE_CFO_SESSION_TIMEOUT_MINUTES=30

# Default is 127.0.0.1. For private Tailscale access, either set:
# GIUSEPPE_CFO_USE_TAILSCALE=1
# or set a specific Tailscale/private-LAN address:
# GIUSEPPE_CFO_BIND_ADDRESS=100.x.y.z
