# Google service account JSON path. Share the accounting spreadsheet and Drive
# folder with this service-account email address.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
ACCOUNTING_SPREADSHEET_ID=
INVOICE_DRIVE_FOLDER_ID=

# Optional. Enables conversational guidance in the chat panel.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Your PMV details, printed on invoices.
BUSINESS_NAME=
BUSINESS_CVR=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
PAYMENT_TERMS_DAYS=14
